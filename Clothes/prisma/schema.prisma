// Reference Prisma schema for a future Next.js/PostgreSQL implementation.
// This static prototype does not execute Prisma or connect to PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id              String   @id @default(cuid())
  slug            String   @unique
  gender          String
  category        String
  nameEn          String
  nameFa          String
  priceUsd        Int
  color           String
  fabric          String
  sizes           String[]
  season          String
  badge           String
  sustainability  Int
  rating          Float
  origin          String
  fit             String
  image           String
  video           String
  story           String
  trace           String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  locale    String   @default("en-US")
  orders    Order[]
  createdAt DateTime @default(now())
}

model Order {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  totalUsd  Int
  status    String   @default("draft")
  createdAt DateTime @default(now())
}
